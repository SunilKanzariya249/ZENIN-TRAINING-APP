# ==============================================================================
# ZENIN MOBILE TASK MANAGEMENT & RPG HUNTER SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
VITE_APP_URL=http://localhost:5173

# Application Environment Mode ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# System Title & Brand Identifier
VITE_APP_TITLE=ZENIN
VITE_APP_ID=com.zenin.app

# ==============================================================================
# SUPABASE FREE CLOUD DATABASE & PHONE OTP AUTHENTICATION
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Run the SQL schema found in 'supabase_schema.sql' via Supabase SQL Editor
# 3. Copy your project URL and public Anon Key from Project Settings > API
# 4. Under Authentication > Providers > Phone, enable Phone provider (SMS OTP)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Audio & Haptic Defaults
VITE_ENABLE_SOUND=true
VITE_ENABLE_HAPTICS=true

# Notification Push Beacon Web VAPID Public Key (Optional for remote push notifications)
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key_here
